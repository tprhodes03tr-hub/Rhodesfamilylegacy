<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rhodes Family Legacy • Wacon Naval & Air Command</title>
    <style>
        :root {
            --bg-color: #050b14;
            --panel-bg: rgba(8, 18, 34, 0.88);
            --border-color: #1e3a60;
            --accent-cyan: #00f3ff;
            --accent-gold: #f39c12;
            --accent-red: #ff3333;
            --text-main: #c0d8f0;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Courier New', Courier, monospace;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            padding: 10px;
            overflow-x: hidden;
        }

        header {
            width: 100%;
            max-width: 500px;
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .nav-btn {
            background: var(--panel-bg);
            border: 1px solid var(--border-color);
            color: var(--accent-cyan);
            padding: 8px 12px;
            font-size: 11px;
            font-weight: bold;
            cursor: pointer;
            text-decoration: none;
            letter-spacing: 1px;
            border-radius: 4px;
            text-align: center;
            flex: 1;
            margin: 0 4px;
            transition: all 0.2s ease;
        }

        .nav-btn:hover {
            border-color: var(--accent-cyan);
            box-shadow: 0 0 10px rgba(0, 243, 255, 0.3);
        }

        .game-container {
            width: 100%;
            max-width: 500px;
            background: var(--panel-bg);
            border: 2px solid var(--border-color);
            border-radius: 8px;
            padding: 12px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.7);
        }

        .hud-header {
            text-align: center;
            font-size: 10px;
            letter-spacing: 2px;
            color: var(--accent-cyan);
            margin-bottom: 6px;
            text-transform: uppercase;
        }

        .stats-bar {
            display: flex;
            justify-content: space-between;
            font-size: 10px;
            background: rgba(0, 0, 0, 0.4);
            padding: 6px 8px;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            margin-bottom: 8px;
        }

        .stat-item span {
            color: var(--accent-gold);
            font-weight: bold;
        }

        .missile-alert {
            background: rgba(255, 51, 51, 0.25);
            border: 1px solid var(--accent-red);
            color: var(--accent-red);
            font-size: 11px;
            font-weight: bold;
            text-align: center;
            padding: 5px;
            border-radius: 4px;
            margin-bottom: 8px;
            display: none;
            animation: pulseAlert 0.5s infinite alternate;
        }

        @keyframes pulseAlert {
            from { opacity: 0.4; }
            to { opacity: 1; }
        }

        canvas {
            width: 100%;
            height: 350px;
            background: #02060c;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            display: block;
            margin-bottom: 10px;
        }

        .radio-dispatch {
            background: rgba(0, 20, 40, 0.9);
            border: 1px dashed var(--accent-gold);
            padding: 8px;
            border-radius: 4px;
            font-size: 11px;
            margin-bottom: 10px;
            display: none;
        }

        .radio-dispatch p {
            color: var(--accent-gold);
            margin-bottom: 4px;
        }

        .radio-dispatch input {
            background: #000;
            border: 1px solid var(--border-color);
            color: #fff;
            padding: 4px 8px;
            font-size: 11px;
            width: 70%;
            border-radius: 3px;
        }

        .radio-dispatch button {
            background: var(--accent-gold);
            border: none;
            color: #000;
            font-weight: bold;
            padding: 5px 10px;
            cursor: pointer;
            border-radius: 3px;
            font-size: 11px;
        }

        .controls-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
            margin-bottom: 8px;
        }

        .ctrl-btn {
            background: rgba(10, 25, 45, 0.9);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 10px;
            font-size: 11px;
            font-weight: bold;
            cursor: pointer;
            border-radius: 4px;
            text-align: center;
            user-select: none;
        }

        .ctrl-btn:active {
            background: var(--border-color);
            color: var(--accent-cyan);
        }

        .action-row {
            display: flex;
            gap: 6px;
        }

        .action-btn {
            flex: 1;
            background: linear-gradient(135deg, #102a45, #1e3a60);
            border: 1px solid var(--accent-cyan);
            color: var(--accent-cyan);
            padding: 9px;
            font-size: 10px;
            font-weight: bold;
            cursor: pointer;
            border-radius: 4px;
            text-align: center;
        }

        .action-btn.evade {
            border-color: var(--accent-gold);
            color: var(--accent-gold);
        }

        .action-btn.fire {
            border-color: var(--accent-red);
            color: var(--accent-red);
        }

        .footer-link {
            text-align: center;
            margin-top: 10px;
            font-size: 10px;
        }

        .footer-link a {
            color: var(--text-main);
            text-decoration: none;
        }

        .footer-link a:hover {
            color: var(--accent-cyan);
        }
    </style>
</head>
<body>

    <header>
        <a href="index.html" class="nav-btn">🌐 COMMAND DECK</a>
        <a href="313-grid.html" class="nav-btn" id="nextStageBtn" style="display:none; border-color: var(--accent-gold); color: var(--accent-gold);">🚀 LAUNCH 313 GRID</a>
    </header>

    <div class="game-container">
        <div class="hud-header" id="modeHeader">WACON TRENCH • SUBMARINE OPS</div>
        
        <div class="stats-bar">
            <div class="stat-item">Integrity: <span id="hullVal">100</span>%</div>
            <div class="stat-item">Objective: <span id="objVal">4500</span>m</div>
            <div class="stat-item">Ammo: <span id="ammoVal">15</span></div>
            <div class="stat-item">Class: <span id="tierVal" style="color: #f59e0b;">MK I</span></div>
        </div>

        <div class="missile-alert" id="missileAlert">
            🚨 MISSILE LOCK-ON! TAP BARREL ROLL TO EVADE!
        </div>

        <div class="radio-dispatch" id="radioBox">
            <p>🔊 [COMMS SECURE] Command: Enter override code to clear blockade!</p>
            <div style="display: flex; gap: 6px;">
                <input type="text" id="codeInput" placeholder="Enter Code (e.g. 313)">
                <button onclick="verifyCode()">TRANSMIT</button>
            </div>
        </div>

        <canvas id="combatCanvas" width="450" height="350"></canvas>

        <div class="controls-grid">
            <div class="ctrl-btn" ontouchstart="moveCraft('left')" onmousedown="moveCraft('left')">◀ STEER PORT</div>
            <div class="ctrl-btn" ontouchstart="moveCraft('right')" onmousedown="moveCraft('right')">STEER STARBOARD ▶</div>
        </div>

        <div class="action-row">
            <button class="action-btn fire" onclick="fireWeapon()">🚀 FIRE WEAPON</button>
            <button class="action-btn evade" onclick="triggerEvade()">🌀 BARREL ROLL</button>
        </div>
    </div>

    <div class="footer-link">
        <a href="index.html">← RETURN TO MAIN LEGACY HUB</a>
    </div>

    <script>
        const canvas = document.getElementById('combatCanvas');
        const ctx = canvas.getContext('2d');

        let craft = { x: 215, y: 280, width: 30, height: 44, speed: 6 };
        let integrity = 100;
        let objectiveProgress = 4500;
        let ammo = 15;
        let craftTier = 1;
        let gameMode = 'submarine'; // 'submarine' or 'jet_dogfight'
        let gameActive = true;
        let activeCode = "313";
        let inCodeLock = false;

        let obstacles = [];
        let projectiles = [];
        let incomingMissiles = [];
        let marineLife = [];

        window.addEventListener('keydown', e => {
            if (e.key === 'ArrowLeft' || e.key === 'a') moveCraft('left');
            if (e.key === 'ArrowRight' || e.key === 'd') moveCraft('right');
            if (e.key === ' ') fireWeapon();
            if (e.key === 'e' || e.key === 'Shift') triggerEvade();
        });

        function moveCraft(dir) {
            if (!gameActive) return;
            let step = craftTier === 3 ? 24 : 20;
            if (dir === 'left') craft.x = Math.max(25, craft.x - step);
            if (dir === 'right') craft.x = Math.min(canvas.width - 35, craft.x + step);
        }

        function fireWeapon() {
            if (!gameActive || ammo <= 0) return;
            ammo--;
            document.getElementById('ammoVal').innerText = ammo;
            projectiles.push({ x: craft.x + 12, y: craft.y, vx: 0, vy: -10, type: gameMode === 'submarine' ? 'torpedo' : 'laser' });
        }

        let isEvading = false;
        function triggerEvade() {
            if (!gameActive || isEvading) return;
            isEvading = true;
            document.getElementById('missileAlert').style.display = 'none';
            incomingMissiles = [];
            setTimeout(() => { isEvading = false; }, 600);
        }

        function checkUpgradeTier() {
            if (objectiveProgress <= 3000 && craftTier < 2) {
                craftTier = 2;
                integrity = Math.min(100, integrity + 25);
                document.getElementById('tierVal').innerText = gameMode === 'submarine' ? "MK II Nautilus" : "MK II Jet";
            } else if (objectiveProgress <= 1500 && craftTier < 3) {
                craftTier = 3;
                integrity = Math.min(100, integrity + 25);
                document.getElementById('tierVal').innerText = gameMode === 'submarine' ? "MK III Dreadnought" : "MK III Apex Fighter";
            }
            document.getElementById('hullVal').innerText = integrity;
        }

        function verifyCode() {
            let userIn = document.getElementById('codeInput').value;
            if (userIn === activeCode) {
                inCodeLock = false;
                document.getElementById('radioBox').style.display = 'none';
                document.getElementById('codeInput').value = '';
                ammo += 6;
                checkUpgradeTier();
                document.getElementById('ammoVal').innerText = ammo;
                obstacles = [];
            } else {
                alert('Incorrect Code! Transmission jammed.');
            }
        }

        function update() {
            if (!gameActive) return;

            objectiveProgress -= 3;
            document.getElementById('objVal').innerText = Math.max(0, objectiveProgress);
            checkUpgradeTier();

            if (objectiveProgress <= 2250 && gameMode === 'submarine') {
                gameMode = 'jet_dogfight';
                document.getElementById('modeHeader').innerText = "CARIBBEAN AIRSPACE • VANGUARD JET INTERCEPT";
                document.getElementById('tierVal').innerText = craftTier === 3 ? "MK III Apex Fighter" : "MK II Jet";
                craft.y = 260;
                objectiveProgress = 2250;
                obstacles = [];
                alert('Submarine mission complete! Surfacing to board Vanguard Interceptor Jet for aerial dogfight.');
            }

            if (objectiveProgress <= 0) {
                gameActive = false;
                document.getElementById('nextStageBtn').style.display = 'block';
                alert('Caribbean Sector Secured! Distress beacon active. You can now launch 313 Grid transit.');
                return;
            }

            if (objectiveProgress === 3500 || objectiveProgress === 1000) {
                inCodeLock = true;
                activeCode = String(Math.floor(100 + Math.random() * 900));
                document.getElementById('radioBox').style.display = 'block';
                document.querySelector('.radio-dispatch p').innerHTML = `🔊 [COMMS SECURE] Input override code <b>${activeCode}</b> to clear sector blockades!`;
            }

            if (Math.random() < 0.035) {
                let type = gameMode === 'submarine' ? (Math.random() > 0.5 ? 'mine' : 'enemy_sub') : (Math.random() > 0.5 ? 'chopper' : 'carrier_jet');
                obstacles.push({
                    x: Math.random() * (canvas.width - 70) + 35,
                    y: -40,
                    type: type,
                    width: 32,
                    height: 32,
                    speed: 2.0 + Math.random() * 1.5
                });
            }

            if (gameMode === 'jet_dogfight' && Math.random() < 0.015 && incomingMissiles.length === 0) {
                incomingMissiles.push({ x: Math.random() * canvas.width, y: -20, speed: 4.5 });
                document.getElementById('missileAlert').style.display = 'block';
            }

            for (let i = obstacles.length - 1; i >= 0; i--) {
                let obs = obstacles[i];
                obs.y += obs.speed;

                if (craft.x < obs.x + obs.width && craft.x + craft.width > obs.x &&
                    craft.y < obs.y + obs.height && craft.y + craft.height > obs.y) {
                    let dmg = craftTier === 3 ? 10 : (craftTier === 2 ? 15 : 20);
                    integrity -= dmg;
                    document.getElementById('hullVal').innerText = Math.max(0, integrity);
                    obstacles.splice(i, 1);
                    if (integrity <= 0) {
                        gameActive = false;
                        alert('Craft Destroyed in Combat Sector!');
                    }
                    continue;
                }
                if (obs.y > canvas.height) obstacles.splice(i, 1);
            }

            for (let i = incomingMissiles.length - 1; i >= 0; i--) {
                let m = incomingMissiles[i];
                m.x += (craft.x - m.x) * 0.05;
                m.y += m.speed;

                if (Math.abs(craft.x - m.x) < 30 && Math.abs(craft.y - m.y) < 30) {
                    if (!isEvading) {
                        integrity -= 30;
                        document.getElementById('hullVal').innerText = Math.max(0, integrity);
                        if (integrity <= 0) {
                            gameActive = false;
                            alert('Missile Impact! Craft Lost.');
                        }
                    }
                    incomingMissiles.splice(i, 1);
                    document.getElementById('missileAlert').style.display = 'none';
                }
                if (m.y > canvas.height) {
                    incomingMissiles.splice(i, 1);
                    document.getElementById('missileAlert').style.display = 'none';
                }
            }

            for (let i = projectiles.length - 1; i >= 0; i--) {
                let p = projectiles[i];
                p.y += p.vy;

                for (let j = obstacles.length - 1; j >= 0; j--) {
                    let obs = obstacles[j];
                    if (p.x > obs.x && p.x < obs.x + obs.width && p.y > obs.y && p.y < obs.y + obs.height) {
                        obstacles.splice(j, 1);
                        projectiles.splice(i, 1);
                        break;
                    }
                }
                if (p.y < 0) projectiles.splice(i, 1);
            }
        }

        function draw() {
            let grad = ctx.createLinearGradient(0, 0, 0, canvas.height);
            if (gameMode === 'submarine') {
                grad.addColorStop(0, '#010814');
                grad.addColorStop(1, '#04182c');
            } else {
                grad.addColorStop(0, '#021a30');
                grad.addColorStop(1, '#0b355e');
            }
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            ctx.save();
            ctx.translate(craft.x, craft.y);
            if (isEvading) ctx.rotate(Date.now() * 0.05);

            if (gameMode === 'submarine') {
                if (craftTier === 1) {
                    ctx.fillStyle = '#00f3ff';
                    ctx.fillRect(4, 8, 22, 28);
                    ctx.fillStyle = '#f39c12';
                    ctx.fillRect(-2, 14, 34, 6);
                } else if (craftTier === 2) {
                    ctx.fillStyle = '#38bdf8';
                    ctx.fillRect(2, 6, 26, 32);
                    ctx.fillStyle = '#60a5fa';
                    ctx.fillRect(-6, 12, 42, 6);
                } else {
                    ctx.fillStyle = '#f59e0b';
                    ctx.fillRect(0, 4, 30, 36);
                    ctx.fillStyle = '#ef4444';
                    ctx.fillRect(-8, 10, 46, 8);
                }
            } else {
                // Jet Dogfight Tier Visuals
                ctx.fillStyle = craftTier === 3 ? '#f59e0b' : '#d4af37';
                ctx.beginPath();
                ctx.moveTo(15, -10);
                ctx.lineTo(-12, 28);
                ctx.lineTo(42, 28);
                ctx.closePath();
                ctx.fill();
                ctx.fillStyle = '#38bdf8';
                ctx.fillRect(12, 5, 6, 12);
            }
            ctx.restore();

            obstacles.forEach(obs => {
                if (obs.type === 'mine' || obs.type === 'chopper') {
                    ctx.fillStyle = obs.type === 'mine' ? '#ff3333' : '#e67e22';
                    ctx.beginPath();
                    ctx.arc(obs.x + 16, obs.y + 16, 14, 0, Math.PI * 2);
                    ctx.fill();
                } else {
                    ctx.fillStyle = '#9b59b6';
                    ctx.fillRect(obs.x, obs.y + 6, 32, 16);
                }
            });

            incomingMissiles.forEach(m => {
                ctx.fillStyle = '#ff3333';
                ctx.shadowColor = '#ff3333';
                ctx.shadowBlur = 10;
                ctx.fillRect(m.x - 3, m.y, 6, 16);
                ctx.shadowBlur = 0;
            });

            projectiles.forEach(p => {
                ctx.fillStyle = p.type === 'torpedo' ? '#ff3333' : '#00f3ff';
                ctx.fillRect(p.x, p.y, 4, 10);
            });
        }

        function loop() {
            update();
            draw();
            requestAnimationFrame(loop);
        }

        loop();
    </script>
</body>
</html>
