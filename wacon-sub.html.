<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rhodes Family Legacy • Wacon Deep-Sea Submarine Command</title>
    <style>
        :root {
            --bg-color: #050b14;
            --panel-bg: rgba(8, 18, 34, 0.85);
            --border-color: #1e3a60;
            --accent-cyan: #00f3ff;
            --accent-gold: #f39c12;
            --accent-red: #ff3333;
            --text-main: #c0d8f0;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Courier New', Courier, monospace;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            padding: 10px;
            overflow-x: hidden;
        }

        header {
            width: 100%;
            max-width: 500px;
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .nav-btn {
            background: var(--panel-bg);
            border: 1px solid var(--border-color);
            color: var(--accent-cyan);
            padding: 8px 12px;
            font-size: 11px;
            font-weight: bold;
            cursor: pointer;
            text-decoration: none;
            letter-spacing: 1px;
            border-radius: 4px;
            text-align: center;
            flex: 1;
            margin: 0 4px;
            transition: all 0.2s ease;
        }

        .nav-btn:hover {
            border-color: var(--accent-cyan);
            box-shadow: 0 0 10px rgba(0, 243, 255, 0.3);
        }

        .game-container {
            width: 100%;
            max-width: 500px;
            background: var(--panel-bg);
            border: 2px solid var(--border-color);
            border-radius: 8px;
            padding: 12px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.7);
        }

        .hud-header {
            text-align: center;
            font-size: 10px;
            letter-spacing: 2px;
            color: var(--accent-cyan);
            margin-bottom: 6px;
            text-transform: uppercase;
        }

        .stats-bar {
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            background: rgba(0, 0, 0, 0.4);
            padding: 6px 10px;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            margin-bottom: 8px;
        }

        .stat-item span {
            color: var(--accent-gold);
            font-weight: bold;
        }

        canvas {
            width: 100%;
            height: 360px;
            background: #02060c;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            display: block;
            margin-bottom: 10px;
        }

        .radio-dispatch {
            background: rgba(0, 20, 40, 0.9);
            border: 1px dashed var(--accent-gold);
            padding: 8px;
            border-radius: 4px;
            font-size: 11px;
            margin-bottom: 10px;
            display: none;
        }

        .radio-dispatch p {
            color: var(--accent-gold);
            margin-bottom: 4px;
        }

        .radio-dispatch input {
            background: #000;
            border: 1px solid var(--border-color);
            color: #fff;
            padding: 4px 8px;
            font-size: 11px;
            width: 70%;
            border-radius: 3px;
        }

        .radio-dispatch button {
            background: var(--accent-gold);
            border: none;
            color: #000;
            font-weight: bold;
            padding: 5px 10px;
            cursor: pointer;
            border-radius: 3px;
            font-size: 11px;
        }

        .controls-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
            margin-bottom: 8px;
        }

        .ctrl-btn {
            background: rgba(10, 25, 45, 0.9);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 12px;
            font-size: 12px;
            font-weight: bold;
            cursor: pointer;
            border-radius: 4px;
            text-align: center;
            user-select: none;
            transition: background 0.1s;
        }

        .ctrl-btn:active {
            background: var(--border-color);
            color: var(--accent-cyan);
        }

        .action-row {
            display: flex;
            gap: 6px;
        }

        .action-btn {
            flex: 1;
            background: linear-gradient(135deg, #102a45, #1e3a60);
            border: 1px solid var(--accent-cyan);
            color: var(--accent-cyan);
            padding: 10px;
            font-size: 11px;
            font-weight: bold;
            cursor: pointer;
            border-radius: 4px;
            text-align: center;
        }

        .action-btn.fire-torpedo {
            border-color: var(--accent-red);
            color: var(--accent-red);
        }

        .action-btn:hover {
            filter: brightness(1.2);
        }

        .footer-link {
            text-align: center;
            margin-top: 10px;
            font-size: 10px;
        }

        .footer-link a {
            color: var(--text-main);
            text-decoration: none;
        }

        .footer-link a:hover {
            color: var(--accent-cyan);
        }
    </style>
</head>
<body>

    <header>
        <a href="index.html" class="nav-btn">🌐 COMMAND DECK</a>
        <a href="313-grid.html" class="nav-btn" id="nextStageBtn" style="display:none; border-color: var(--accent-gold); color: var(--accent-gold);">🚀 LAUNCH 313 GRID</a>
    </header>

    <div class="game-container">
        <div class="hud-header">WACON TRENCH • CARIBBEAN SECTOR O-DEFENSE</div>
        
        <div class="stats-bar">
            <div class="stat-item">Hull: <span id="hullVal">100</span>%</div>
            <div class="stat-item">Sector Depth: <span id="depthVal">4500</span>m</div>
            <div class="stat-item">Torpedoes: <span id="torpVal">12</span></div>
            <div class="stat-item">Relics: <span id="relicVal">0</span></div>
        </div>

        <div class="radio-dispatch" id="radioBox">
            <p>🔊 [COMMS SECURE] Command: Enter override code to clear minefield!</p>
            <div style="display: flex; gap: 6px;">
                <input type="text" id="codeInput" placeholder="Enter Code (e.g. 313)">
                <button onclick="verifyCode()">TRANSMIT</button>
            </div>
        </div>

        <canvas id="subCanvas" width="450" height="360"></canvas>

        <div class="controls-grid">
            <div class="ctrl-btn" ontouchstart="moveSub('left')" onmousedown="moveSub('left')">◀ STEER PORT</div>
            <div class="ctrl-btn" ontouchstart="moveSub('right')" onmousedown="moveSub('right')">STEER STARBOARD ▶</div>
        </div>

        <div class="action-row">
            <button class="action-btn fire-torpedo" onclick="fireWeapon('torpedo')">🚀 FIRE SEEKING TORPEDO</button>
            <button class="action-btn" onclick="fireWeapon('laser')">⚡ PULSE LASER</button>
        </div>
    </div>

    <div class="footer-link">
        <a href="index.html">← RETURN TO MAIN LEGACY HUB</a>
    </div>

    <script>
        const canvas = document.getElementById('subCanvas');
        const ctx = canvas.getContext('2d');

        // Game State
        let sub = { x: 215, y: 300, width: 28, height: 42, speed: 4 };
        let hull = 100;
        let depth = 4500;
        let torpedoes = 12;
        let relics = 0;
        let gameActive = true;
        let activeCode = "313";
        let inCodeLock = false;

        let obstacles = []; // Mines & Albor Patrol Subs
        let projectiles = []; // Torpedoes & Lasers
        let particles = []; // Bubbles & debris
        let marineLife = []; // Fish / Octopuses

        // Controls
        let keys = { left: false, right: false };

        window.addEventListener('keydown', e => {
            if (e.key === 'ArrowLeft' || e.key === 'a') sub.x = Math.max(20, sub.x - 15);
            if (e.key === 'ArrowRight' || e.key === 'd') sub.x = Math.min(canvas.width - 40, sub.x + 15);
            if (e.key === ' ') fireWeapon('torpedo');
        });

        function moveSub(dir) {
            if (dir === 'left') sub.x = Math.max(20, sub.x - 20);
            if (dir === 'right') sub.x = Math.min(canvas.width - 40, sub.x + 20);
        }

        function fireWeapon(type) {
            if (!gameActive) return;
            if (type === 'torpedo' && torpedoes > 0) {
                torpedoes--;
                projectiles.push({ x: sub.x + 10, y: sub.y, vx: 0, vy: -7, type: 'torpedo' });
            } else if (type === 'laser') {
                projectiles.push({ x: sub.x + 12, y: sub.y, vx: 0, vy: -12, type: 'laser' });
            }
            document.getElementById('torpVal').innerText = torpedoes;
        }

        // Spawn environment elements
        function spawnElements() {
            if (!gameActive) return;
            // Spawn mines or Albor scout subs
            if (Math.random() < 0.03) {
                obstacles.push({
                    x: Math.random() * (canvas.width - 60) + 30,
                    y: -40,
                    type: Math.random() > 0.4 ? 'mine' : 'albor_sub',
                    width: 30,
                    height: 30,
                    speed: 1.5 + Math.random() * 1.5
                });
            }
            // Spawn marine life (fish / coral particles)
            if (Math.random() < 0.05) {
                marineLife.push({
                    x: Math.random() * canvas.width,
                    y: canvas.height + 10,
                    speed: 0.5 + Math.random() * 1,
                    size: 2 + Math.random() * 4
                });
            }
        }

        function triggerRadioCheck() {
            inCodeLock = true;
            activeCode = String(Math.floor(100 + Math.random() * 900));
            document.getElementById('radioBox').style.display = 'block';
            document.querySelector('.radio-dispatch p').innerHTML = `🔊 [COMMS SECURE] Input override code <b>${activeCode}</b> to clear sector blockades!`;
        }

        function verifyCode() {
            let userIn = document.getElementById('codeInput').value;
            if (userIn === activeCode) {
                inCodeLock = false;
                document.getElementById('radioBox').style.display = 'none';
                document.getElementById('codeInput').value = '';
                relics += 2;
                document.getElementById('relicVal').innerText = relics;
                // Clear all mines on screen
                obstacles = [];
            } else {
                alert('Incorrect Code! Transmission jammed.');
            }
        }

        // Main Game Loop
        function update() {
            if (!gameActive) return;

            depth -= 2;
            document.getElementById('depthVal').innerText = Math.max(0, depth);

            if (depth <= 0) {
                gameActive = false;
                document.getElementById('nextStageBtn').style.display = 'block';
                alert('Wacon Trench Cleared! Distress beacon relayed to Detroit Grid. You can now launch 313 Grid transit.');
                return;
            }

            // Trigger random comms check
            if (depth === 3000 || depth === 1500) {
                triggerRadioCheck();
            }

            spawnElements();

            // Update obstacles
            for (let i = obstacles.length - 1; i >= 0; i--) {
                let obs = obstacles[i];
                obs.y += obs.speed;

                // Collision with sub
                if (sub.x < obs.x + obs.width && sub.x + sub.width > obs.x &&
                    sub.y < obs.y + obs.height && sub.y + sub.height > obs.y) {
                    hull -= 20;
                    document.getElementById('hullVal').innerText = Math.max(0, hull);
                    obstacles.splice(i, 1);
                    if (hull <= 0) {
                        gameActive = false;
                        alert('Hull Breached! Submarine disabled in Caribbean Trench.');
                    }
                    continue;
                }

                // Remove off-screen
                if (obs.y > canvas.height) {
                    obstacles.splice(i, 1);
                }
            }

            // Update projectiles
            for (let i = projectiles.length - 1; i >= 0; i--) {
                let p = projectiles[i];
                p.y += p.vy;

                // Check hit on obstacles
                for (let j = obstacles.length - 1; j >= 0; j--) {
                    let obs = obstacles[j];
                    if (p.x > obs.x && p.x < obs.x + obs.width && p.y > obs.y && p.y < obs.y + obs.height) {
                        obstacles.splice(j, 1);
                        projectiles.splice(i, 1);
                        relics += 1;
                        document.getElementById('relicVal').innerText = relics;
                        break;
                    }
                }

                if (p.y < 0) projectiles.splice(i, 1);
            }

            // Update marine life
            for (let i = marineLife.length - 1; i >= 0; i--) {
                let m = marineLife[i];
                m.y -= m.speed;
                if (m.y < -10) marineLife.splice(i, 1);
            }
        }

        function draw() {
            // Clear canvas with dark deep-sea blue gradient
            let grad = ctx.createLinearGradient(0, 0, 0, canvas.height);
            grad.addColorStop(0, '#010814');
            grad.addColorStop(1, '#04182c');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Draw Marine Life (Bio-luminescent drift)
            ctx.fillStyle = 'rgba(0, 243, 255, 0.3)';
            marineLife.forEach(m => {
                ctx.beginPath();
                ctx.arc(m.x, m.y, m.size, 0, Math.PI * 2);
                ctx.fill();
            });

            // Draw Submarine (Wacon Deep-Sea Vessel)
            ctx.fillStyle = '#00f3ff';
            ctx.fillRect(sub.x + 6, sub.y + 10, 16, 22); // Hull
            ctx.fillStyle = '#f39c12';
            ctx.fillRect(sub.x, sub.y + 18, 28, 6); // Wing fins
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(sub.x + 10, sub.y + 4, 8, 8); // Conning tower / cockpit

            // Draw Obstacles (Mines & Albor Drones)
            obstacles.forEach(obs => {
                if (obs.type === 'mine') {
                    ctx.fillStyle = '#ff3333';
                    ctx.beginPath();
                    ctx.arc(obs.x + 15, obs.y + 15, 12, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.strokeStyle = '#fff';
                    ctx.stroke();
                } else {
                    ctx.fillStyle = '#9b59b6'; // Albor hostile sub
                    ctx.fillRect(obs.x, obs.y + 5, 30, 15);
                    ctx.fillStyle = '#ff3333';
                    ctx.fillRect(obs.x + 10, obs.y, 10, 5);
                }
            });

            // Draw Projectiles
            projectiles.forEach(p => {
                ctx.fillStyle = p.type === 'torpedo' ? '#ff3333' : '#00f3ff';
                ctx.fillRect(p.x, p.y, 4, 10);
            });
        }

        function loop() {
            update();
            draw();
            requestAnimationFrame(loop);
        }

        loop();
    </script>
</body>
</html>
