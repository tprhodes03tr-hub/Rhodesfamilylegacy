<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rhodes Family Legacy • Wacon Deep-Sea Submarine Command</title>
    <style>
        :root {
            --bg-color: #050b14;
            --panel-bg: rgba(8, 18, 34, 0.85);
            --border-color: #1e3a60;
            --accent-cyan: #00f3ff;
            --accent-gold: #f39c12;
            --accent-red: #ff3333;
            --text-main: #c0d8f0;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Courier New', Courier, monospace;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            padding: 10px;
            overflow-x: hidden;
        }

        header {
            width: 100%;
            max-width: 500px;
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .nav-btn {
            background: var(--panel-bg);
            border: 1px solid var(--border-color);
            color: var(--accent-cyan);
            padding: 8px 12px;
            font-size: 11px;
            font-weight: bold;
            cursor: pointer;
            text-decoration: none;
            letter-spacing: 1px;
            border-radius: 4px;
            text-align: center;
            flex: 1;
            margin: 0 4px;
            transition: all 0.2s ease;
        }

        .nav-btn:hover {
            border-color: var(--accent-cyan);
            box-shadow: 0 0 10px rgba(0, 243, 255, 0.3);
        }

        .game-container {
            width: 100%;
            max-width: 500px;
            background: var(--panel-bg);
            border: 2px solid var(--border-color);
            border-radius: 8px;
            padding: 12px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.7);
        }

        .hud-header {
            text-align: center;
            font-size: 10px;
            letter-spacing: 2px;
            color: var(--accent-cyan);
            margin-bottom: 6px;
            text-transform: uppercase;
        }

        .stats-bar {
            display: flex;
            justify-content: space-between;
            font-size: 10px;
            background: rgba(0, 0, 0, 0.4);
            padding: 6px 8px;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            margin-bottom: 8px;
        }

        .stat-item span {
            color: var(--accent-gold);
            font-weight: bold;
        }

        canvas {
            width: 100%;
            height: 360px;
            background: #02060c;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            display: block;
            margin-bottom: 10px;
        }

        .radio-dispatch {
            background: rgba(0, 20, 40, 0.9);
            border: 1px dashed var(--accent-gold);
            padding: 8px;
            border-radius: 4px;
            font-size: 11px;
            margin-bottom: 10px;
            display: none;
        }

        .radio-dispatch p {
            color: var(--accent-gold);
            margin-bottom: 4px;
        }

        .radio-dispatch input {
            background: #000;
            border: 1px solid var(--border-color);
            color: #fff;
            padding: 4px 8px;
            font-size: 11px;
            width: 70%;
            border-radius: 3px;
        }

        .radio-dispatch button {
            background: var(--accent-gold);
            border: none;
            color: #000;
            font-weight: bold;
            padding: 5px 10px;
            cursor: pointer;
            border-radius: 3px;
            font-size: 11px;
        }

        .controls-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
            margin-bottom: 8px;
        }

        .ctrl-btn {
            background: rgba(10, 25, 45, 0.9);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 12px;
            font-size: 12px;
            font-weight: bold;
            cursor: pointer;
            border-radius: 4px;
            text-align: center;
            user-select: none;
        }

        .ctrl-btn:active {
            background: var(--border-color);
            color: var(--accent-cyan);
        }

        .action-row {
            display: flex;
            gap: 6px;
        }

        .action-btn {
            flex: 1;
            background: linear-gradient(135deg, #102a45, #1e3a60);
            border: 1px solid var(--accent-cyan);
            color: var(--accent-cyan);
            padding: 10px;
            font-size: 11px;
            font-weight: bold;
            cursor: pointer;
            border-radius: 4px;
            text-align: center;
        }

        .action-btn.fire-torpedo {
            border-color: var(--accent-red);
            color: var(--accent-red);
        }

        .footer-link {
            text-align: center;
            margin-top: 10px;
            font-size: 10px;
        }

        .footer-link a {
            color: var(--text-main);
            text-decoration: none;
        }

        .footer-link a:hover {
            color: var(--accent-cyan);
        }
    </style>
</head>
<body>

    <header>
        <a href="index.html" class="nav-btn">🌐 COMMAND DECK</a>
        <a href="313-grid.html" class="nav-btn" id="nextStageBtn" style="display:none; border-color: var(--accent-gold); color: var(--accent-gold);">🚀 LAUNCH 313 GRID</a>
    </header>

    <div class="game-container">
        <div class="hud-header">WACON TRENCH • CARIBBEAN SECTOR O-DEFENSE</div>
        
        <div class="stats-bar">
            <div class="stat-item">Hull: <span id="hullVal">100</span>%</div>
            <div class="stat-item">Depth: <span id="depthVal">4500</span>m</div>
            <div class="stat-item">Torp: <span id="torpVal">12</span></div>
            <div class="stat-item">Relics: <span id="relicVal">0</span></div>
            <div class="stat-item">Tier: <span id="tierVal" style="color: #f59e0b;">MK I</span></div>
        </div>

        <div class="radio-dispatch" id="radioBox">
            <p>🔊 [COMMS SECURE] Command: Enter override code to clear minefield!</p>
            <div style="display: flex; gap: 6px;">
                <input type="text" id="codeInput" placeholder="Enter Code (e.g. 313)">
                <button onclick="verifyCode()">TRANSMIT</button>
            </div>
        </div>

        <canvas id="subCanvas" width="450" height="360"></canvas>

        <div class="controls-grid">
            <div class="ctrl-btn" ontouchstart="moveSub('left')" onmousedown="moveSub('left')">◀ STEER PORT</div>
            <div class="ctrl-btn" ontouchstart="moveSub('right')" onmousedown="moveSub('right')">STEER STARBOARD ▶</div>
        </div>

        <div class="action-row">
            <button class="action-btn fire-torpedo" onclick="fireWeapon('torpedo')">🚀 SEEKING TORPEDO</button>
            <button class="action-btn" onclick="fireWeapon('laser')">⚡ PULSE LASER</button>
        </div>
    </div>

    <div class="footer-link">
        <a href="index.html">← RETURN TO MAIN LEGACY HUB</a>
    </div>

    <script>
        const canvas = document.getElementById('subCanvas');
        const ctx = canvas.getContext('2d');

        let sub = { x: 215, y: 300, width: 28, height: 42, speed: 5 };
        let hull = 100;
        let depth = 4500;
        let torpedoes = 12;
        let relics = 0;
        let subTier = 1; // MK I to MK III
        let gameActive = true;
        let activeCode = "313";
        let inCodeLock = false;

        let obstacles = [];
        let projectiles = [];
        let marineLife = [];

        window.addEventListener('keydown', e => {
            if (e.key === 'ArrowLeft' || e.key === 'a') sub.x = Math.max(20, sub.x - 18);
            if (e.key === 'ArrowRight' || e.key === 'd') sub.x = Math.min(canvas.width - 40, sub.x + 18);
            if (e.key === ' ') fireWeapon('torpedo');
        });

        function moveSub(dir) {
            let step = subTier === 3 ? 24 : 18;
            if (dir === 'left') sub.x = Math.max(20, sub.x - step);
            if (dir === 'right') sub.x = Math.min(canvas.width - 40, sub.x + step);
        }

        function fireWeapon(type) {
            if (!gameActive) return;
            if (type === 'torpedo' && torpedoes > 0) {
                torpedoes--;
                projectiles.push({ x: sub.x + 10, y: sub.y, vx: 0, vy: -8, type: 'torpedo' });
            } else if (type === 'laser') {
                let spread = subTier >= 2 ? [-8, 0, 8] : [0];
                spread.forEach(off => {
                    projectiles.push({ x: sub.x + 12 + off, y: sub.y, vx: 0, vy: -12, type: 'laser' });
                });
            }
            document.getElementById('torpVal').innerText = torpedoes;
        }

        function checkSubTier() {
            if (relics >= 6 && subTier < 3) {
                subTier = 3;
                hull = Math.min(100, hull + 30);
                document.getElementById('tierVal').innerText = "MK III (Apex Dreadnought)";
            } else if (relics >= 3 && subTier < 2) {
                subTier = 2;
                hull = Math.min(100, hull + 20);
                document.getElementById('tierVal').innerText = "MK II (Tactical Nautilus)";
            }
            document.getElementById('hullVal').innerText = hull;
        }

        function spawnElements() {
            if (!gameActive) return;
            if (Math.random() < 0.035) {
                obstacles.push({
                    x: Math.random() * (canvas.width - 60) + 30,
                    y: -40,
                    type: Math.random() > 0.4 ? 'mine' : 'albor_sub',
                    width: 32,
                    height: 32,
                    speed: 1.8 + Math.random() * 1.5
                });
            }
            if (Math.random() < 0.05) {
                marineLife.push({
                    x: Math.random() * canvas.width,
                    y: canvas.height + 10,
                    speed: 0.6 + Math.random() * 1,
                    size: 2 + Math.random() * 4
                });
            }
        }

        function triggerRadioCheck() {
            inCodeLock = true;
            activeCode = String(Math.floor(100 + Math.random() * 900));
            document.getElementById('radioBox').style.display = 'block';
            document.querySelector('.radio-dispatch p').innerHTML = `🔊 [COMMS SECURE] Input override code <b>${activeCode}</b> to clear sector blockades!`;
        }

        function verifyCode() {
            let userIn = document.getElementById('codeInput').value;
            if (userIn === activeCode) {
                inCodeLock = false;
                document.getElementById('radioBox').style.display = 'none';
                document.getElementById('codeInput').value = '';
                relics += 2;
                checkSubTier();
                document.getElementById('relicVal').innerText = relics;
                obstacles = [];
            } else {
                alert('Incorrect Code! Transmission jammed.');
            }
        }

        function update() {
            if (!gameActive) return;

            depth -= 2;
            document.getElementById('depthVal').innerText = Math.max(0, depth);

            if (depth <= 0) {
                gameActive = false;
                document.getElementById('nextStageBtn').style.display = 'block';
                alert('Wacon Trench Cleared! Distress beacon relayed. You can now launch 313 Grid transit.');
                return;
            }

            if (depth === 3000 || depth === 1500) {
                triggerRadioCheck();
            }

            spawnElements();

            for (let i = obstacles.length - 1; i >= 0; i--) {
                let obs = obstacles[i];
                obs.y += obs.speed;

                if (sub.x < obs.x + obs.width && sub.x + sub.width > obs.x &&
                    sub.y < obs.y + obs.height && sub.y + sub.height > obs.y) {
                    let damage = subTier === 3 ? 10 : (subTier === 2 ? 15 : 20);
                    hull -= damage;
                    document.getElementById('hullVal').innerText = Math.max(0, hull);
                    obstacles.splice(i, 1);
                    if (hull <= 0) {
                        gameActive = false;
                        alert('Hull Breached! Submarine disabled in Caribbean Trench.');
                    }
                    continue;
                }

                if (obs.y > canvas.height) {
                    obstacles.splice(i, 1);
                }
            }

            for (let i = projectiles.length - 1; i >= 0; i--) {
                let p = projectiles[i];
                p.y += p.vy;

                for (let j = obstacles.length - 1; j >= 0; j--) {
                    let obs = obstacles[j];
                    if (p.x > obs.x && p.x < obs.x + obs.width && p.y > obs.y && p.y < obs.y + obs.height) {
                        obstacles.splice(j, 1);
                        projectiles.splice(i, 1);
                        relics += 1;
                        checkSubTier();
                        document.getElementById('relicVal').innerText = relics;
                        break;
                    }
                }

                if (p.y < 0) projectiles.splice(i, 1);
            }

            for (let i = marineLife.length - 1; i >= 0; i--) {
                let m = marineLife[i];
                m.y -= m.speed;
                if (m.y < -10) marineLife.splice(i, 1);
            }
        }

        function draw() {
            let grad = ctx.createLinearGradient(0, 0, 0, canvas.height);
            grad.addColorStop(0, '#010814');
            grad.addColorStop(1, '#04182c');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            ctx.fillStyle = 'rgba(0, 243, 255, 0.3)';
            marineLife.forEach(m => {
                ctx.beginPath();
                ctx.arc(m.x, m.y, m.size, 0, Math.PI * 2);
                ctx.fill();
            });

            // DRAW TRANSFORMING SUBMARINE HULL BASED ON TIER
            ctx.save();
            ctx.translate(sub.x, sub.y);

            if (subTier === 1) {
                // MK I: Recon Sub
                ctx.fillStyle = '#00f3ff';
                ctx.fillRect(4, 10, 20, 24);
                ctx.fillStyle = '#f39c12';
                ctx.fillRect(0, 16, 28, 6);
            } else if (subTier === 2) {
                // MK II: Tactical Nautilus
                ctx.fillStyle = '#38bdf8';
                ctx.fillRect(2, 8, 24, 28);
                ctx.fillStyle = '#60a5fa';
                ctx.fillRect(-4, 14, 36, 6);
            } else {
                // MK III: Apex Abyssal Dreadnought
                ctx.fillStyle = '#f59e0b';
                ctx.shadowColor = '#f59e0b';
                ctx.shadowBlur = 15;
                ctx.fillRect(0, 6, 28, 32);
                ctx.fillStyle = '#ef4444';
                ctx.fillRect(-6, 12, 40, 8);
                ctx.shadowBlur = 0;
            }

            ctx.fillStyle = '#ffffff';
            ctx.fillRect(8, 2, 12, 10); // Cockpit viewport

            ctx.restore();

            obstacles.forEach(obs => {
                if (obs.type === 'mine') {
                    ctx.fillStyle = '#ff3333';
                    ctx.beginPath();
                    ctx.arc(obs.x + 16, obs.y + 16, 14, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.strokeStyle = '#fff';
                    ctx.stroke();
                } else {
                    ctx.fillStyle = '#9b59b6';
                    ctx.fillRect(obs.x, obs.y + 6, 32, 16);
                    ctx.fillStyle = '#ff3333';
                    ctx.fillRect(obs.x + 10, obs.y, 12, 6);
                }
            });

            projectiles.forEach(p => {
                ctx.fillStyle = p.type === 'torpedo' ? '#ff3333' : '#00f3ff';
                ctx.fillRect(p.x, p.y, 4, 10);
            });
        }

        function loop() {
            update();
            draw();
            requestAnimationFrame(loop);
        }

        loop();
    </script>
</body>
</html>
