<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
  <title>The Ancestral Vanguard: 3D Flight & Power Arena - Rhodes Legacy</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
    }
    body {
      background-color: #030712;
      color: #fff;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      overflow: hidden;
      touch-action: none;
    }
    #game-container {
      position: absolute;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
    }
    /* Top Hero & Stats HUD */
    #hud {
      position: absolute;
      top: 10px;
      left: 10px;
      right: 10px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      pointer-events: none;
      z-index: 10;
    }
    #hero-select-bar {
      display: flex;
      gap: 6px;
      pointer-events: auto;
      overflow-x: auto;
      white-space: nowrap;
    }
    .hero-btn {
      background: rgba(15, 23, 42, 0.85);
      border: 2px solid #facc15;
      color: #facc15;
      padding: 6px 12px;
      border-radius: 8px;
      font-weight: 800;
      font-size: 0.8rem;
      cursor: pointer;
    }
    .hero-btn.active {
      background: #facc15;
      color: #0f172a;
    }
    .hud-row {
      display: flex;
      justify-content: space-between;
      font-weight: 800;
      font-size: 0.95rem;
      text-shadow: 0 0 10px rgba(0,0,0,0.9);
    }
    .hud-stat {
      background: rgba(15, 23, 42, 0.75);
      border: 1px solid #38bdf8;
      padding: 6px 12px;
      border-radius: 8px;
    }
    #reticle {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 30px;
      height: 30px;
      border: 2px dashed #38bdf8;
      border-radius: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
      z-index: 10;
    }
    #reticle::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 6px;
      height: 6px;
      background: #facc15;
      border-radius: 50%;
      transform: translate(-50%, -50%);
    }
    /* Touch Flight Stick & Abilities */
    .touch-zone {
      position: absolute;
      bottom: 25px;
      width: 130px;
      height: 130px;
      z-index: 20;
    }
    #flight-stick {
      left: 20px;
      background: rgba(56, 189, 248, 0.08);
      border: 2px solid rgba(56, 189, 248, 0.4);
      border-radius: 50%;
    }
    .stick-knob {
      position: absolute;
      top: 40px;
      left: 40px;
      width: 50px;
      height: 50px;
      background: rgba(56, 189, 248, 0.35);
      border: 2px solid #38bdf8;
      border-radius: 50%;
      pointer-events: none;
    }
    .power-btn {
      position: absolute;
      border-radius: 50%;
      z-index: 20;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      color: #fff;
    }
    #blast-btn {
      bottom: 120px;
      right: 25px;
      width: 78px;
      height: 78px;
      background: linear-gradient(135deg, rgba(234, 179, 8, 0.7), rgba(239, 68, 68, 0.7));
      border: 3px solid #fde047;
      font-size: 0.85rem;
      box-shadow: 0 0 15px rgba(250, 204, 21, 0.4);
    }
    #burst-btn {
      bottom: 25px;
      right: 35px;
      width: 68px;
      height: 68px;
      background: linear-gradient(135deg, rgba(168, 85, 247, 0.7), rgba(59, 130, 246, 0.7));
      border: 2px solid #a855f7;
      font-size: 0.75rem;
      box-shadow: 0 0 15px rgba(168, 85, 247, 0.4);
    }
    #blast-btn:active, #burst-btn:active {
      transform: scale(0.92);
      opacity: 0.9;
    }
  </style>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>
  <div id="game-container"></div>

  <div id="hud">
    <div id="hero-select-bar">
      <button class="hero-btn active" onclick="setVanguard('solaris')">☀️ Solaris (Solar Laser)</button>
      <button class="hero-btn" onclick="setVanguard('tempest')">⚡ Tempest (Lightning Lance)</button>
      <button class="hero-btn" onclick="setVanguard('titan')">🛡️ Titan (Cosmic Quake)</button>
    </div>
    <div class="hud-row">
      <div class="hud-stat" id="hud-hp">Vanguard Health: 100%</div>
      <div class="hud-stat" id="hud-score">Evil Defeated: 0</div>
    </div>
  </div>

  <div id="reticle"></div>

  <!-- Flight & Superpower Controls -->
  <div id="flight-stick" class="touch-zone">
    <div id="flight-knob" class="stick-knob"></div>
  </div>
  <button id="blast-btn" class="power-btn">ENERGY BLAST</button>
  <button id="burst-btn" class="power-btn">ANCESTRAL NOVA</button>

  <script>
    let scene, camera, renderer;
    let heroHP = 100, score = 0, isGameOver = false;
    let villains = [];
    let powerProjectiles = [];
    let villainShots = [];

    const flightInput = { pitch: 0, yaw: 0 };
    let boostActive = false;
    let flightSpeed = 1.2;

    const vanguardHeroes = {
      solaris: { color: 0xffbb00, aura: 0xff6600, speed: 4.8, dmg: 40, burstCount: 16 },
      tempest: { color: 0x00e5ff, aura: 0x7c3aed, speed: 6.2, dmg: 30, burstCount: 20 },
      titan: { color: 0x22c55e, aura: 0xeab308, speed: 3.8, dmg: 70, burstCount: 12 }
    };
    let currentHero = 'solaris';

    function setVanguard(heroKey) {
      currentHero = heroKey;
      document.querySelectorAll('.hero-btn').forEach(b => b.classList.remove('active'));
      event.target.classList.add('active');
    }

    function init() {
      const container = document.getElementById('game-container');

      scene = new THREE.Scene();
      scene.fog = new THREE.FogExp2(0x060b18, 0.0012);

      camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 3500);
      camera.position.set(0, 40, 0);
      camera.rotation.order = 'YXZ';

      renderer = new THREE.WebGLRenderer({ antialias: true });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setClearColor(0x040814);
      container.appendChild(renderer.domElement);

      // Celestial & Ambient Lights
      const ambient = new THREE.AmbientLight(0x475569, 1.2);
      scene.add(ambient);

      const sun = new THREE.DirectionalLight(0xfff7ed, 2.2);
      sun.position.set(150, 300, 150);
      scene.add(sun);

      buildCityAndSpaceArena();
      setupControls();
      spawnVillainWave();
    }

    // 3D Neon Megacity & Sky Megaliths
    function buildCityAndSpaceArena() {
      const bldgMat = new THREE.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.3, metalness: 0.8 });
      const gridHelper = new THREE.GridHelper(2000, 40, 0x38bdf8, 0x1e293b);
      gridHelper.position.y = -60;
      scene.add(gridHelper);

      // Skyscrapers & Floating Obelisks
      for (let i = 0; i < 60; i++) {
        const height = 80 + Math.random() * 220;
        const width = 25 + Math.random() * 30;
        const bldgGeo = new THREE.BoxGeometry(width, height, width);
        const building = new THREE.Mesh(bldgGeo, bldgMat);
        building.position.set(
          THREE.MathUtils.randFloatSpread(1400),
          height / 2 - 60,
          THREE.MathUtils.randFloatSpread(1400)
        );
        scene.add(building);
      }
    }

    // Evil Overlord / Doom Drone Mesh
    function createVillainMesh() {
      const villain = new THREE.Group();

      const coreMat = new THREE.MeshStandardMaterial({ color: 0x991b1b, roughness: 0.2, metalness: 0.9 });
      const wingMat = new THREE.MeshStandardMaterial({ color: 0x18181b, roughness: 0.4 });
      const eyeMat = new THREE.MeshBasicMaterial({ color: 0xff0055 });

      // Spiked Core
      const core = new THREE.Mesh(new THREE.OctahedronGeometry(3.5, 0), coreMat);
      villain.add(core);

      const eye = new THREE.Mesh(new THREE.SphereGeometry(1.2, 8, 8), eyeMat);
      eye.position.set(0, 0, -3.2);
      villain.add(eye);

      // Dark Wings
      const leftWing = new THREE.Mesh(new THREE.ConeGeometry(2.5, 9, 4), wingMat);
      leftWing.position.set(-4.5, 0, 0);
      leftWing.rotation.z = Math.PI / 2.5;
      villain.add(leftWing);

      const rightWing = new THREE.Mesh(new THREE.ConeGeometry(2.5, 9, 4), wingMat);
      rightWing.position.set(4.5, 0, 0);
      rightWing.rotation.z = -Math.PI / 2.5;
      villain.add(rightWing);

      return villain;
    }

    function spawnVillain() {
      if (isGameOver) return;
      const v = createVillainMesh();

      const angle = Math.random() * Math.PI * 2;
      const dist = 160 + Math.random() * 90;
      v.position.set(
        camera.position.x + Math.sin(angle) * dist,
        camera.position.y + (Math.random() - 0.5) * 80,
        camera.position.z + Math.cos(angle) * dist
      );

      v.lastCast = Date.now() + Math.random() * 2000;
      scene.add(v);
      villains.push(v);
    }

    function spawnVillainWave() {
      for (let i = 0; i < 6; i++) {
        spawnVillain();
      }
    }

    // Hero Primary Superpower Shot
    function firePowerBlast() {
      if (isGameOver) return;
      const hero = vanguardHeroes[currentHero];

      const projGeo = new THREE.SphereGeometry(0.8, 8, 8);
      const projMat = new THREE.MeshBasicMaterial({ color: hero.color });

      const dir = new THREE.Vector3();
      camera.getWorldDirection(dir);

      const blast = new THREE.Mesh(projGeo, projMat);
      blast.position.copy(camera.position);
      blast.velocity = dir.clone().multiplyScalar(hero.speed);
      blast.dmg = hero.dmg;

      scene.add(blast);
      powerProjectiles.push(blast);
    }

    // Hero Ultimate Nova Attack
    function fireAncestralNova() {
      if (isGameOver) return;
      const hero = vanguardHeroes[currentHero];

      for (let i = 0; i < hero.burstCount; i++) {
        const projGeo = new THREE.SphereGeometry(0.9, 8, 8);
        const projMat = new THREE.MeshBasicMaterial({ color: hero.aura });

        const angle = (Math.PI * 2 / hero.burstCount) * i;
        const dir = new THREE.Vector3(Math.cos(angle), (Math.random() - 0.5) * 0.4, Math.sin(angle)).normalize();

        const blast = new THREE.Mesh(projGeo, projMat);
        blast.position.copy(camera.position);
        blast.velocity = dir.multiplyScalar(hero.speed * 0.9);
        blast.dmg = hero.dmg * 1.5;

        scene.add(blast);
        powerProjectiles.push(blast);
      }
    }

    function villainAttack(villain) {
      const shotGeo = new THREE.SphereGeometry(0.7, 6, 6);
      const shotMat = new THREE.MeshBasicMaterial({ color: 0xff0033 });

      const dir = new THREE.Vector3().subVectors(camera.position, villain.position).normalize();
      const shot = new THREE.Mesh(shotGeo, shotMat);
      shot.position.copy(villain.position);
      shot.velocity = dir.multiplyScalar(2.6);

      scene.add(shot);
      villainShots.push(shot);
    }

    function setupControls() {
      const stick = document.getElementById('flight-stick');
      const knob = document.getElementById('flight-knob');
      let touchId = null, center = { x: 0, y: 0 };

      stick.addEventListener('touchstart', (e) => {
        const touch = e.changedTouches[0];
        touchId = touch.identifier;
        const rect = stick.getBoundingClientRect();
        center = { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
      }, { passive: false });

      stick.addEventListener('touchmove', (e) => {
        for (let i = 0; i < e.changedTouches.length; i++) {
          const t = e.changedTouches[i];
          if (t.identifier === touchId) {
            const dx = t.clientX - center.x;
            const dy = t.clientY - center.y;
            const dist = Math.min(45, Math.hypot(dx, dy));
            const angle = Math.atan2(dy, dx);

            knob.style.transform = `translate(${Math.cos(angle) * dist}px, ${Math.sin(angle) * dist}px)`;
            flightInput.yaw = -(Math.cos(angle) * dist) / 45;
            flightInput.pitch = -(Math.sin(angle) * dist) / 45;
          }
        }
      }, { passive: false });

      const resetStick = (e) => {
        for (let i = 0; i < e.changedTouches.length; i++) {
          if (e.changedTouches[i].identifier === touchId) {
            touchId = null;
            knob.style.transform = 'translate(0px, 0px)';
            flightInput.yaw = 0;
            flightInput.pitch = 0;
          }
        }
      };
      stick.addEventListener('touchend', resetStick);
      stick.addEventListener('touchcancel', resetStick);

      // Buttons
      document.getElementById('blast-btn').addEventListener('touchstart', (e) => {
        e.preventDefault();
        firePowerBlast();
      });
      document.getElementById('burst-btn').addEventListener('touchstart', (e) => {
        e.preventDefault();
        fireAncestralNova();
      });

      // Keyboard support
      window.addEventListener('keydown', (e) => {
        if (e.code === 'KeyW' || e.code === 'ArrowUp') flightInput.pitch = 1;
        if (e.code === 'KeyS' || e.code === 'ArrowDown') flightInput.pitch = -1;
        if (e.code === 'KeyA' || e.code === 'ArrowLeft') flightInput.yaw = 1;
        if (e.code === 'KeyD' || e.code === 'ArrowRight') flightInput.yaw = -1;
        if (e.code === 'ShiftLeft') boostActive = true;
        if (e.code === 'Space') firePowerBlast();
        if (e.code === 'KeyE') fireAncestralNova();
      });
      window.addEventListener('keyup', (e) => {
        if (['KeyW', 'KeyS', 'ArrowUp', 'ArrowDown'].includes(e.code)) flightInput.pitch = 0;
        if (['KeyA', 'KeyD', 'ArrowLeft', 'ArrowRight'].includes(e.code)) flightInput.yaw = 0;
        if (e.code === 'ShiftLeft') boostActive = false;
      });
    }

    function updateHUD() {
      document.getElementById('hud-hp').innerText = `Vanguard Health: ${Math.max(0, Math.floor(heroHP))}%`;
      document.getElementById('hud-score').innerText = `Evil Defeated: ${score}`;
    }

    const clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);
      if (isGameOver) return;

      const delta = clock.getDelta();

      // Steering
      camera.rotation.y += flightInput.yaw * 1.6 * delta;
      camera.rotation.x = Math.max(-Math.PI / 2.3, Math.min(Math.PI / 2.3, camera.rotation.x + flightInput.pitch * 1.4 * delta));

      // Flight Propel
      const speed = (boostActive ? flightSpeed * 2.5 : flightSpeed);
      const forward = new THREE.Vector3();
      camera.getWorldDirection(forward);
      camera.position.addScaledVector(forward, speed * 30 * delta);

      // Update Hero Projectiles
      for (let i = powerProjectiles.length - 1; i >= 0; i--) {
        const p = powerProjectiles[i];
        p.position.add(p.velocity);

        if (p.position.distanceTo(camera.position) > 280) {
          scene.remove(p);
          powerProjectiles.splice(i, 1);
          continue;
        }

        // Check collision against villains
        for (let j = villains.length - 1; j >= 0; j--) {
          const v = villains[j];
          if (p.position.distanceTo(v.position) < 4.8) {
            scene.remove(v);
            scene.remove(p);
            villains.splice(j, 1);
            powerProjectiles.splice(i, 1);
            score++;
            updateHUD();
            setTimeout(spawnVillain, 1800);
            break;
          }
        }
      }

      // Update Dark Villain Magic Shots
      for (let i = villainShots.length - 1; i >= 0; i--) {
        const s = villainShots[i];
        s.position.add(s.velocity);

        if (s.position.distanceTo(camera.position) < 3.2) {
          heroHP -= 15;
          scene.remove(s);
          villainShots.splice(i, 1);
          updateHUD();
          if (heroHP <= 0) {
            isGameOver = true;
            alert('The Vanguard forces require regrouping! Reload the page to stand and fight.');
          }
          continue;
        }

        if (s.position.distanceTo(camera.position) > 280) {
          scene.remove(s);
          villainShots.splice(i, 1);
        }
      }

      // Villains AI Tracking & Flight
      const now = Date.now();
      villains.forEach((v) => {
        const toHero = new THREE.Vector3().subVectors(camera.position, v.position);
        const dist = toHero.length();
        toHero.normalize();

        v.position.addScaledVector(toHero, 10.5 * delta);
        v.lookAt(camera.position);

        // Core spin animation
        v.children[0].rotation.y += 0.05;
        v.children[0].rotation.x += 0.03;

        // Villain casts dark energy
        if (dist < 130 && now - v.lastCast > 3000) {
          villainAttack(v);
          v.lastCast = now;
        }
      });

      renderer.render(scene, camera);
    }

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    init();
    updateHUD();
    animate();
  </script>
</body>
</html>
